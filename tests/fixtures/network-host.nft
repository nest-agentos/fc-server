table inet nestos_firecracker {
set blocked { type ipv4_addr; flags interval; elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }; }
set proxy_peers { type ifname . ipv4_addr . ipv4_addr . inet_service; }
set published_marks { type mark; }
chain published_guard { ct mark @published_marks ct status dnat accept
ct mark & 0xff000000 == 0xfc000000 drop
}
chain published_forward { }
chain output { type filter hook output priority 0; policy accept; oifname "mfc-h*" jump published_guard
}
chain input { type filter hook input priority -20; policy accept;
iifname "mfc-h*" jump published_guard
iifname . ip saddr . ip daddr . tcp dport @proxy_peers accept
iifname "mfc-h*" ct state established,related accept
iifname "mfc-h*" drop
}
chain forward { type filter hook forward priority -20; policy accept;
iifname "mfc-h0" ip saddr != { 10.203.0.2, 10.204.0.2 } drop
iifname "mfc-h*" jump published_guard
oifname "mfc-h*" jump published_guard
iifname . ip saddr . ip daddr . tcp dport @proxy_peers accept
iifname "mfc-h*" ip daddr @blocked drop
iifname "mfc-h*" oifname "eth0" meta nfproto ipv4 accept
iifname "eth0" oifname "mfc-h*" ct state established,related accept
iifname "mfc-h*" drop
oifname "mfc-h*" drop
}
}
table ip nestos_firecracker_nat {
chain published_prerouting { }
chain published_output { }
chain published_snat { }
chain prerouting { type nat hook prerouting priority dstnat; policy accept; iifname != "mfc-h*" jump published_prerouting
}
chain output { type nat hook output priority dstnat; policy accept; jump published_output
}
chain postrouting { type nat hook postrouting priority srcnat; policy accept; jump published_snat
iifname "mfc-h*" oifname "eth0" masquerade
}
}
