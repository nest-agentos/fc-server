table inet mindos_firecracker {
set blocked { type ipv4_addr; flags interval; elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }; }
set proxy_targets { type ipv4_addr . inet_service; }
chain input { type filter hook input priority 0; policy drop;
iifname "lo" accept
ct state established,related accept
iifname "fc-tap" udp dport 67 accept
iifname "fc-tap" ip saddr 10.203.0.2 ip daddr 10.203.0.1 udp dport 53 accept
iifname "fc-tap" ip saddr 10.203.0.2 ip daddr 10.203.0.1 tcp dport 53 accept
iifname "fc-tap" ip daddr 10.203.0.1 icmp type echo-request accept
}
chain published_forward { }
chain forward { type filter hook forward priority 0; policy drop;
iifname "fc-tap" ip saddr != 10.203.0.2 drop
ct state established,related accept
jump published_forward
iifname "fc-tap" ip daddr . tcp dport @proxy_targets accept
iifname "mfc-n0" ip saddr 10.204.0.1 ip daddr 10.203.0.2 tcp dport 22 accept
iifname "fc-tap" ip daddr @blocked drop
iifname "fc-tap" oifname "mfc-n0" ip saddr 10.203.0.2 accept
}
}
