#!/usr/bin/env python3
"""Offline runtime probe, executed as the same user as guest services."""
import json
from pathlib import Path
import shutil
import subprocess
import time
import tempfile


def probe(program):
    started = time.monotonic()
    result = subprocess.run([program, '--version'], capture_output=True, text=True, timeout=30)
    if result.returncode:
        raise RuntimeError(f'{program} version probe failed: exit={result.returncode} {result.stderr[-400:]}')
    return {'version': result.stdout.strip(), 'probe_ms': round((time.monotonic() - started) * 1000)}


def main():
    flavor = Path('/usr/share/nestos-image/flavor').read_text().strip()
    for program in ('bash', 'git', 'git-lfs', 'ssh', 'python3', 'udevadm', 'socat', 'mount',
                    'less', 'vim', 'fd', 'rg', 'top', 'ps', 'free', 'ss', 'ip',
                    'curl', 'jq', 'file', 'tree', 'lsof', 'ping', 'dig', 'unzip',
                    'rsync', 'pstree'):
        assert shutil.which(program), f'missing guest component: {program}'
    assert Path('/usr/lib/systemd/systemd').is_file(), 'missing systemd PID 1'
    assert not shutil.which('npm'), 'npm must stay in the build stage'
    packages = subprocess.check_output(['dpkg-query', '-W', '-f=${Package}\n'], text=True).splitlines()
    if flavor == 'base':
        assert not any(name.endswith('-dev') for name in packages), 'development packages in base image'
    for unit in ('apt-daily.timer', 'apt-daily-upgrade.timer', 'dpkg-db-backup.timer',
                 'fstrim.timer', 'systemd-networkd-wait-online.service'):
        path = Path('/etc/systemd/system') / unit
        assert path.is_symlink() and path.readlink() == Path('/dev/null'), f'unit must be masked: {unit}'
    evidence = {'flavor': flavor, 'package_count': len(packages), 'runtimes': {}}
    for program in ('git', 'git-lfs'):
        evidence['runtimes'][program] = probe(program)
    if flavor == 'harness':
        for program in ('make', 'c++', 'pkg-config'):
            evidence['runtimes'][program] = probe(program)
        with tempfile.TemporaryDirectory(prefix='native-build-') as directory:
            source, binary = Path(directory) / 'probe.cc', Path(directory) / 'probe'
            source.write_text('#include <pty.h>\n#include <unistd.h>\nint main(){int m,s;if(openpty(&m,&s,nullptr,nullptr,nullptr))return 1;close(m);close(s);return 0;}\n')
            subprocess.run(['c++', str(source), '-lutil', '-o', str(binary)], check=True, timeout=30)
            subprocess.run([str(binary)], check=True, timeout=10)
        for program in ('node', 'codex', 'claude', 'dsh'):
            evidence['runtimes'][program] = probe(program)
    print(json.dumps(evidence))


if __name__ == '__main__':
    main()
