+/// Query a pinned inode without following a host path or exposing uninitialized bytes.
+pub(super) fn extended_statx(
+    fd: std::os::unix::io::RawFd,
+    flags: u32,
+    mask: u32,
+) -> io::Result<libc::statx> {
+    if flags & !(libc::AT_STATX_SYNC_TYPE as u32) != 0 {
+        return Err(io::Error::from_raw_os_error(libc::EINVAL));
+    }
+    let mut value = MaybeUninit::<libc::statx>::zeroed();
+    // SAFETY: the empty name is NUL terminated; the output is writable and checked before use.
+    let result = unsafe {
+        libc::syscall(
+            libc::SYS_statx,
+            fd,
+            EMPTY_CSTR.as_ptr(),
+            libc::AT_EMPTY_PATH | libc::AT_SYMLINK_NOFOLLOW | flags as i32,
+            (mask & 0xfff) | libc::STATX_BASIC_STATS,
+            value.as_mut_ptr(),
+        )
+    };
+    if result < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: the successful syscall initialized the zeroed output structure.
+    Ok(unsafe { value.assume_init() })
+}
+
+#[cfg(test)]
+mod extended_tests {
+    use super::*;
+    #[test]
+    fn statx_matches_host_birth_time_and_rejects_invalid_fd_and_flags() {
+        use std::os::unix::fs::MetadataExt;
+        let file = std::fs::File::open(".").unwrap();
+        let raw = extended_statx(file.as_raw_fd(), 0, 0xfff).unwrap();
+        assert_eq!(raw.stx_ino, file.metadata().unwrap().ino());
+        if let Ok(created) = file.metadata().unwrap().created() {
+            let stamp = created.duration_since(std::time::UNIX_EPOCH).unwrap();
+            assert_ne!(raw.stx_mask & libc::STATX_BTIME, 0);
+            assert_eq!(raw.stx_btime.tv_sec, stamp.as_secs() as i64);
+            assert_eq!(raw.stx_btime.tv_nsec, stamp.subsec_nanos());
+        }
+        assert_eq!(
+            extended_statx(-1, 0, 0xfff).unwrap_err().raw_os_error(),
+            Some(libc::EBADF)
+        );
+        assert_eq!(
+            extended_statx(file.as_raw_fd(), libc::AT_SYMLINK_FOLLOW as u32, 0xfff)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EINVAL)
+        );
+    }
+}
