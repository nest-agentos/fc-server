+// FUSE 7.39 statx ABI: all reserved fields are initialized to zero.
+#[repr(C)]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct SxTime {
+    pub sec: i64,
+    pub nsec: u32,
+    pub reserved: i32,
+}
+unsafe impl ByteValued for SxTime {}
+
+#[repr(C)]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct Statx {
+    pub mask: u32,
+    pub blksize: u32,
+    pub attributes: u64,
+    pub nlink: u32,
+    pub uid: GuestUid,
+    pub gid: GuestGid,
+    pub mode: u16,
+    pub spare: u16,
+    pub ino: u64,
+    pub size: u64,
+    pub blocks: u64,
+    pub attributes_mask: u64,
+    pub atime: SxTime,
+    pub btime: SxTime,
+    pub ctime: SxTime,
+    pub mtime: SxTime,
+    pub rdev_major: u32,
+    pub rdev_minor: u32,
+    pub dev_major: u32,
+    pub dev_minor: u32,
+    pub spare2: [u64; 14],
+}
+unsafe impl ByteValued for Statx {}
+
+impl Statx {
+    pub fn from_host(st: libc::statx, uid: GuestUid, gid: GuestGid) -> Self {
+        let time = |t: libc::statx_timestamp| SxTime {
+            sec: t.tv_sec,
+            nsec: t.tv_nsec,
+            reserved: 0,
+        };
+        Self {
+            mask: st.stx_mask & 0xfff,
+            blksize: st.stx_blksize,
+            attributes: st.stx_attributes,
+            nlink: st.stx_nlink,
+            uid,
+            gid,
+            mode: st.stx_mode,
+            spare: 0,
+            ino: st.stx_ino,
+            size: st.stx_size,
+            blocks: st.stx_blocks,
+            attributes_mask: st.stx_attributes_mask,
+            atime: time(st.stx_atime),
+            ctime: time(st.stx_ctime),
+            mtime: time(st.stx_mtime),
+            btime: if st.stx_mask & 0x800 != 0 {
+                time(st.stx_btime)
+            } else {
+                SxTime::default()
+            },
+            rdev_major: st.stx_rdev_major,
+            rdev_minor: st.stx_rdev_minor,
+            dev_major: st.stx_dev_major,
+            dev_minor: st.stx_dev_minor,
+            spare2: [0; 14],
+        }
+    }
+}
+
+#[repr(C)]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct StatxIn {
+    pub getattr_flags: u32,
+    pub reserved: u32,
+    pub fh: u64,
+    pub sx_flags: u32,
+    pub sx_mask: u32,
+}
+unsafe impl ByteValued for StatxIn {}
+
+#[repr(C)]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct StatxOut {
+    pub attr_valid: u64,
+    pub attr_valid_nsec: u32,
+    pub flags: u32,
+    pub spare: [u64; 2],
+    pub stat: Statx,
+}
+unsafe impl ByteValued for StatxOut {}
+
+#[cfg(test)]
+mod statx_tests {
+    use super::*;
+    #[test]
+    fn statx_wire_layout_and_absent_birth_time() {
+        assert_eq!(std::mem::size_of::<SxTime>(), 16);
+        assert_eq!(std::mem::size_of::<Statx>(), 256);
+        assert_eq!(std::mem::size_of::<StatxIn>(), 24);
+        assert_eq!(std::mem::size_of::<StatxOut>(), 288);
+        assert_eq!(std::mem::offset_of!(StatxOut, stat), 32);
+        assert_eq!(std::mem::offset_of!(Statx, btime), 80);
+        let mut raw = unsafe { std::mem::zeroed::<libc::statx>() };
+        raw.stx_mask = 0x7ff;
+        raw.stx_btime.tv_sec = 123;
+        let wire = Statx::from_host(raw, GuestUid::from(1000), GuestGid::from(1001));
+        assert_eq!(wire.btime.sec, 0);
+        assert_eq!(wire.mask & 0x800, 0);
+        assert_eq!(wire.uid, GuestUid::from(1000));
+        assert_eq!(wire.gid, GuestGid::from(1001));
+        raw.stx_mask |= 0x800;
+        raw.stx_btime.tv_nsec = 456;
+        let wire = Statx::from_host(raw, GuestUid::from(0), GuestGid::from(0));
+        assert_eq!(
+            (wire.btime.sec, wire.btime.nsec, wire.btime.reserved),
+            (123, 456, 0)
+        );
+    }
+}
 
